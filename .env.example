# Copy this file to .env and fill in your own values. Never commit the real .env file.

# MongoDB Atlas connection string (optional if you are using a local instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/jharkhand-tourism

# Local MongoDB fallback for development, useful when Atlas is unavailable or the IP is not whitelisted
LOCAL_MONGO_URI=mongodb://127.0.0.1:27017/jharkhand-tourism

# Any long random string, used to sign session cookies
SESSION_SECRET=changeThisToSomethingRandom

# Port the server runs on locally
PORT=3000

# Free LLM API key (Groq: https://console.groq.com) — needed only once you build the trip planner
GROQ_API_KEY=

# Cloudinary image storage (use the full value from the Cloudinary API Keys page)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
