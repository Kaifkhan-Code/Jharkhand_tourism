<% layout('layouts/boilerplate') %>

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>My itinerary</h2>
      <span class="section-label"><%= itinerary.length %> saved place<%= itinerary.length !== 1 ? 's' : '' %></span>
    </div>

    <% if (itinerary.length === 0) { %>
      <div class="empty-state">
        <h3>Your trip is still a blank page</h3>
        <p>Open a place and add it here when you find somewhere you want to visit.</p>
        <a href="/places" class="btn btn-primary">Explore places</a>
      </div>
    <% } else { %>
      <div class="itinerary-list">
        <% itinerary.forEach((entry, index) => { %>
          <% if (entry.place) { %>
            <article class="itinerary-item">
              <div class="itinerary-number"><%= String(index + 1).padStart(2, '0') %></div>
              <img class="itinerary-img" src="<%= entry.place.image && entry.place.image.url ? entry.place.image.url : 'https://placehold.co/240x160/1e3b2c/f7f2e8?text=' + encodeURIComponent(entry.place.name) %>" alt="<%= entry.place.name %>">
              <div class="itinerary-copy">
                <div class="place-card-district"><%= entry.place.district %> District</div>
                <h3><a href="/places/<%= entry.place._id %>"><%= entry.place.name %></a></h3>
                <p><%= entry.place.description.slice(0, 120) %><%= entry.place.description.length > 120 ? '…' : '' %></p>
              </div>
              <form action="/itinerary/places/<%= entry.place._id %>?_method=DELETE" method="POST">
                <button type="submit" class="btn btn-outline">Remove</button>
              </form>
            </article>
          <% } %>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
