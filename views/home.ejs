<script>
  const districtScroller = document.querySelector('.district-explorer');
  const districtPrev = document.querySelector('.district-nav-prev');
  const districtNext = document.querySelector('.district-nav-next');

  if (districtScroller) {
    const scrollByCard = () => {
      const firstCard = districtScroller.querySelector('.district-card');
      if (!firstCard) return 250;
      return firstCard.getBoundingClientRect().width + 14;
    };

    districtPrev?.addEventListener('click', () => {
      districtScroller.scrollBy({ left: -scrollByCard(), behavior: 'smooth' });
    });

    districtNext?.addEventListener('click', () => {
      districtScroller.scrollBy({ left: scrollByCard(), behavior: 'smooth' });
    });

    districtScroller.addEventListener('wheel', (event) => {
      const scrollerWidth = districtScroller.scrollWidth - districtScroller.clientWidth;
      if (scrollerWidth <= 0) return;

      event.preventDefault();
      event.stopPropagation();
      districtScroller.scrollLeft += event.deltaY;
    }, { passive: false });

    const updateNavButtons = () => {
      const maxScroll = districtScroller.scrollWidth - districtScroller.clientWidth;
      if (districtPrev) districtPrev.disabled = districtScroller.scrollLeft <= 8;
      if (districtNext) districtNext.disabled = districtScroller.scrollLeft >= maxScroll - 8;
    };

    districtScroller.addEventListener('scroll', updateNavButtons);
    window.addEventListener('resize', updateNavButtons);
    updateNavButtons();
  }

  document.querySelectorAll('.district-card').forEach((card) => {
    card.addEventListener('click', (event) => {
      if (event.target.closest('.district-area-tag')) return;
      const url = card.dataset.districtUrl;
      if (url) window.location.href = url;
    });
  });
</script>

