<% layout('layouts/boilerplate') %>

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2><%= query.area ? query.area + ' places' : 'Explore Jharkhand' %></h2>
      <span class="section-label"><%= places.length %> place<%= places.length !== 1 ? 's' : '' %></span>
    </div>

    <div class="pill-row">
      <a href="/places" class="pill <%= !query.category ? 'active' : '' %>">All</a>
      <a href="/places?category=waterfall" class="pill <%= query.category === 'waterfall' ? 'active' : '' %>">Waterfalls</a>
      <a href="/places?category=hill-station" class="pill <%= query.category === 'hill-station' ? 'active' : '' %>">Hill Stations</a>
      <a href="/places?category=wildlife" class="pill <%= query.category === 'wildlife' ? 'active' : '' %>">Wildlife</a>
      <a href="/places?category=temple" class="pill <%= query.category === 'temple' ? 'active' : '' %>">Temples</a>
      <a href="/places?category=tribal-heritage" class="pill <%= query.category === 'tribal-heritage' ? 'active' : '' %>">Tribal Heritage</a>
      <a href="/places?category=dam-lake" class="pill <%= query.category === 'dam-lake' ? 'active' : '' %>">Dams &amp; Lakes</a>
      <a href="/places?category=nature" class="pill <%= query.category === 'nature' ? 'active' : '' %>">Nature</a>
      <a href="/places?category=park" class="pill <%= query.category === 'park' ? 'active' : '' %>">Parks</a>
    </div>

    <% if (places.length === 0) { %>
      <div class="empty-state">
        <h3>Nothing here yet</h3>
        <p>Try a different category, or run <code>npm run seed</code> to load starter places.</p>
      </div>
    <% } else { %>
      <div class="place-grid">
        <% places.forEach(place => { %>
          <% const placeId = place && place._id ? place._id.toString() : (place && place.id ? place.id.toString() : null); %>
          <a href="/places/<%= place._id || place.id %>" class="place-card">
            <% if (placeId && visitedIds.includes(placeId)) { %>
              <div class="visited-stamp">Been<br>There</div>
            <% } %>
            <img class="place-card-img" src="<%= place.image && place.image.url ? place.image.url : 'https://placehold.co/400x260/1e3b2c/f7f2e8?text=' + encodeURIComponent(place.name) %>" alt="<%= place.name %>">
            <div class="place-card-body">
              <div class="place-card-district"><%= place.district %> District</div>
              <h3><%= place.name %></h3>
              <p><%= place.description.slice(0, 90) %><%= place.description.length > 90 ? '…' : '' %></p>
              <div class="tag-row">
                <span class="tag"><%= place.category.replace('-', ' ') %></span>
                <span class="tag"><%= place.bestSeason %></span>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>
