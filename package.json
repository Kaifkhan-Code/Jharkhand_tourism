{
  "name": "jharkhand-tourism",
  "version": "1.0.0",
  "description": "A trip-planning and discovery site for Jharkhand tourism, built MVC-style with Express, MongoDB and EJS.",
  "main": "app.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed": "node seed/seedPlaces.js",
    "update-map-links": "node scripts/updatePlaceMapLinks.js",
    "resolve-map-coordinates": "node scripts/resolveMapCoordinates.js",
    "migrate-images": "node scripts/migrateImagesToCloudinary.js",
    "make-admin": "node scripts/makeAdmin.js"
  },
  "dependencies": {
    "cloudinary": "^2.10.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "ejs-mate": "^4.0.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.5.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^8.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
